# NER Landslide Intelligence Platform - Environment Variables
# Copy this file to .env:
#   cp .env.example .env

# -------------------------------------------------------------
# 1. Backend API (FastAPI + PostGIS)
# -------------------------------------------------------------
# Base URL for the Python backend. Defaults to localhost:8000.
# If offline, the platform automatically uses local mock data.
VITE_API_BASE_URL=http://localhost:8000/api

# -------------------------------------------------------------
# 2. AI Emergency Advisory Generator (Google Gemini) - Free
# -------------------------------------------------------------
# Generates real-time NDMA-compliant operational advisories.
# Free Tier: Get key in 1 min at https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# -------------------------------------------------------------
# 3. Weather & Live Precipitation Telemetry (OpenWeatherMap) - Free
# -------------------------------------------------------------
# Real-time rainfall & humidity for monitored NER hill districts.
# Free Tier (1,000 calls/day): https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# -------------------------------------------------------------
# 4. Satellite Imagery & Topographic Basemaps
# -------------------------------------------------------------
# NOTE: The platform ALREADY includes 100% FREE, NO-KEY-REQUIRED
# high-resolution Satellite (Esri World Imagery) and Topographic
# relief (OpenTopoMap) basemaps out of the box!
#
# If you optionally want Mapbox custom styles, enter your token below:
# Free Tier: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=

# -------------------------------------------------------------
# 5. Routing Engine API (OpenRouteService) - Optional Free
# -------------------------------------------------------------
# Dynamic bypass routing & elevation profiles.
# Free Tier (2,000 calls/day): https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=
